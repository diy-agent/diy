const wsUrl = process.argv[2]!;
const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
const ws = new WebSocket(wsUrl);
await new Promise<void>((r, j) => { ws.onopen = () => r(); ws.onerror = () => j(new Error("ws")); });
let seq = 0; const pend = new Map<number, (v: any) => void>();
ws.onmessage = (e: MessageEvent) => { const m = JSON.parse(String(e.data)); if (m.id) pend.get(m.id)?.(m); };
const send = (method: string, params: any = {}, sid?: string) => new Promise<any>((r) => { const id = ++seq; pend.set(id, r); ws.send(JSON.stringify({ id, method, params, ...(sid ? { sessionId: sid } : {}) })); });
const t = await send("Target.getTargets");
const page = (t.result.targetInfos as any[]).find((x) => x.type === "page");
const sid = (await send("Target.attachToTarget", { targetId: page.targetId, flatten: true })).result.sessionId;
const ev = async (x: string) => (await send("Runtime.evaluate", { expression: x, awaitPromise: true, returnByValue: true }, sid)).result?.result?.value;
const hover = async () => { await ev(`(() => { const b=[...document.querySelectorAll('button')].find(x=>(x.getAttribute('aria-label')||'').startsWith('窗口占用')); b.dispatchEvent(new Event('pointerenter',{bubbles:true})); return 1; })()`); await sleep(1200); };
const card = () => ev(`(() => { const el=document.querySelector('[data-compact-cut-bar]'); if(!el) return 'absent';
  const s=el.querySelector('[data-cut-slider]');
  return { min:s?.min, max:s?.max, val:s?.value, txt:(el.textContent||'').replace(/\\s+/g,' ').trim(), dis:el.querySelector('[data-cut-apply]')?.disabled }; })()`);
await hover();
console.log("A:", JSON.stringify(await card()));
await ev(`(() => { const el=document.querySelector('[data-compact-cut-bar]'); const s=el.querySelector('[data-cut-slider]'); s.value=s.min; s.dispatchEvent(new Event('input',{bubbles:true})); return 1; })()`);
await sleep(500); await hover();
console.log("B 拖到最小:", JSON.stringify(await card()));
await ev(`document.querySelector('[data-compact-cut-bar] [data-cut-apply]')?.click()`);
await sleep(3500); await hover();
console.log("C 落盘后:", JSON.stringify(await card()));
console.log("note:", await ev(`(document.querySelector('[data-cut-note]')?.textContent||'(无)').trim()`));
ws.close();
