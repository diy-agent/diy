#!/usr/bin/env node
// bin/diy2 —— 全局命令入口（npm link / 发布后都走它）。
//
// 只做三件事，一行命令语义都不留在这：
//   1. 找到 **CLI 产物** `build/prod/cli/index.mjs`（固定路径：一个包目录一份产物）；
//   2. 清掉继承来的 `DIY2_*` 环境变量（本进程与它拉起的子进程都看不见）；
//   3. 把 argv 原样交过去 —— 子命令 / 选项 / help / 退出码 / `web` 的拉起与复用全在 TS 侧
//      （src/cli：`@diy-agent/rpc/cli` + 参数声明在 src/cli/options.ts）。
//
// 为什么这里不再解析参数（##dev-app 构建对齐的后续）：以前 bin 有一份自己的
// `valueOf` / `has` / `command`，还得把「bin 级选项」从 argv 里摘掉再转给 CLI；
// 服务端入口读另一份 `DIY2_*` 环境变量；CLI 侧第三份 zod 声明 —— 三份描述同一组参数，
// 改一处漏两处。现在「产物之前的逻辑」只剩下面这一个 existsSync。
//
// 为什么清环境而不是读环境：环境变量谁都能改、看不见、还会继承 —— 外层 shell / agent 里
// 漏出来的 `DIY2_ENV=production` 会让一次实验去写生产数据根（实测现场）。规矩是
// **参数走 argv，环境变量只出不进**（见 server/config.ts 文件头）。

import { existsSync, readFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const pkgRoot = join(dirname(fileURLToPath(import.meta.url)), '..');
const cliEntry = join(pkgRoot, 'build', 'prod', 'cli', 'index.mjs');

for (const key of Object.keys(process.env)) {
    if (/^DIY2_/.test(key)) delete process.env[key];
}

if (!existsSync(cliEntry)) {
    let version = '';
    try {
        version = JSON.parse(readFileSync(join(pkgRoot, 'package.json'), 'utf8')).version ?? '';
    } catch {
        /* 包清单读不到就算了，这行只是提示 */
    }
    console.error(`${version === '' ? 'diy2' : `diy2 ${version}`}：缺 CLI 产物\n  ${cliEntry}`);
    console.error(`  仓库里：cd ${pkgRoot} && ./sha.sh build`);
    console.error('  npm 安装的包：重新安装一次（发布产物里应该带 build/prod/）');
    process.exit(78); // EX_CONFIG
}

// CLI 产物顶层自己做 `process.exit(code)`；这里的 exitCode 只是「万一它没退」的兜底
const loaded = await import(pathToFileURL(cliEntry).href);
process.exitCode = loaded?.exitCode ?? process.exitCode ?? 0;
