{
  "name": "@diy-agent/app-minimal",
  "version": "0.1.0",
  "private": true,
  "description": "最小工作台装配：外壳 + 布局骨架 + 页面插件（第一刀：假 LlmPort，只验 UI 链路）",
  "files": [
