  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "electron": "^43.0.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.0.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
