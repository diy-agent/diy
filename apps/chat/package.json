{
  "name": "@diy-agent/app-chat",
  "version": "0.1.2",
  "private": true,
  "description": "多会话聊天应用：左侧会话列表 + 主区消息流 + 顶部模型选择器；会话落盘 jsonl，模型来自 model.yaml",
  "files": [
    "bin/",
    "build/"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@diy-agent/log": "*",
    "@diy-agent/bot": "*",
    "@diy-agent/bot-config-page": "*",
    "@diy-agent/chat-page": "*",
    "@diy-agent/llm-provider": "*",
    "@diy-agent/model-catalog": "*",
    "@diy-agent/model-config-page": "*",
    "@diy-agent/session": "*",
    "@diy-agent/session-store-jsonl": "*",
    "@diy-agent/session-store-memory": "*",
    "@diy-agent/time": "*",
    "@diy-agent/workbench": "*",
    "@diy-agent/workbench-ui": "*",
    "electron": "^43.8.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.0.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "bin": {
    "diy-chat": "./bin/diy-chat.mjs"
  }
}
