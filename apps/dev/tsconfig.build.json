{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "rootDir": ".",
        "outDir": "lib",
        "noEmit": false,
        "composite": false,
        "incremental": false,
        "declaration": true,
        "sourceMap": true
    },
    "include": ["index.ts", "title.ts", "shared.ts", "discovery.ts", "instances.ts", "actions.ts", "dev-page.ts", "main.ts", "preload.ts", "renderer.ts"],
    "exclude": ["tests/**/*", "vitest.config.ts"]
}
