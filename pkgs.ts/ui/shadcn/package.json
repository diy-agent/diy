{
    "name": "@diy-agent/ui-shadcn",
    "version": "0.1.0",
    "private": true,
    "description": "shadcn（base-nova / Base UI）组件层：纯展示、props 进 DOM 出；同时是 cn 工具与语义变量（styles.css）的唯一真源",
    "files": [
        "src"
    ],
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./styles.css": "./src/styles.css"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@shadcn/react": "^0.3.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.545.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    },
    "peerDependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
