{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
    // tsc -b 需要 composite；增量信息落 node_modules/.cache（不污染包目录、不进 git）
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/tsconfig.build.tsbuildinfo",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "rootDir": "src",
        "outDir": "dist",
        "noEmit": false,


        "declaration": true,
        "sourceMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["tests/**/*"]
,
  "references": [
    { "path": "../../model/catalog/tsconfig.build.json" },
    { "path": "../workbench/tsconfig.build.json" },
    { "path": "../workbench-ui/tsconfig.build.json" }
  ]
}
