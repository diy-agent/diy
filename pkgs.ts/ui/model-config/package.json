{
  "name": "@diy-agent/model-config-page",
  "version": "0.1.1",
  "private": true,
  "description": "模型配置页面插件：provider / 模型 / 账号 / 默认模型（key 只写不回显）；不装就没有入口；入口分工：`.` = 主进程（方法表），`./renderer` = 浏览器（纯 DOM）",
  "files": [
    "src/"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./src/view.ts",
      "default": "./dist/view.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@diy-agent/model-catalog": "*",
    "@diy-agent/workbench": "*",
    "@diy-agent/workbench-ui": "*"
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
