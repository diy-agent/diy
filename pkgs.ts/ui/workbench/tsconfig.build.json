{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
    // tsc -b 需要 composite；增量信息落 node_modules/.cache（不污染包目录、不进 git）
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/tsconfig.build.tsbuildinfo",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node"],
        "rootDir": "src",
        "outDir": "lib",
        "noEmit": false,


        "declaration": true,
        "sourceMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["tests/**/*"]
}
