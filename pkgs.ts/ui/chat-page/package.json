{
  "name": "@diy-agent/chat-page",
  "version": "0.1.1",
  "private": true,
  "description": "聊天页面插件：主进程侧用 @diy-agent/session + 假 LlmPort；renderer 只有 React 19 + shadcn 一版；入口分工：`.` = 主进程（方法表），`./renderer-react` = 浏览器，`./react.css` = 样式",
  "files": [
    "src/"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./src/main.ts",
      "default": "./dist/main.js"
    },
    "./blocks": {
      "types": "./src/blocks.ts",
      "default": "./dist/blocks.js"
    },
    "./block-renderers": {
      "types": "./src/block-renderers.ts",
      "default": "./dist/block-renderers.js"
    },
    "./renderer-react": {
      "types": "./src/renderer-react.tsx",
      "default": "./dist/renderer-react.js"
    },
    "./react.css": "./src/react.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@diy-agent/bot": "*",
    "@diy-agent/session": "*",
    "@diy-agent/ui-design": "^0.1.0",
    "@diy-agent/workbench": "*",
    "@diy-agent/workbench-ui": "*",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "ai": "^7.0.169",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@diy-agent/test-llm": "0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
