{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
    // tsc -b 需要 composite；增量信息落 node_modules/.cache（不污染包目录、不进 git）
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/tsconfig.build.tsbuildinfo",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "rootDir": "src",
        "outDir": "dist",
        "noEmit": false,
        // shadcn CLI 用（aliases 必须能在 paths 里解析）；TS 7 已移除 baseUrl，
        // paths 直接相对 tsconfig 目录。emit 不重写路径，所以生成物里的
        // `@/lib/utils` 提交前改回相对 import（dist 要被 Node 直接加载）
        "paths": { "@/*": ["./src/*"] },


        "declaration": true,
        "sourceMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["tests/**/*"]
,
  "references": [
    { "path": "../../agent/bot/tsconfig.build.json" },
    { "path": "../../agent/session/tsconfig.build.json" },
    { "path": "../workbench/tsconfig.build.json" },
    { "path": "../workbench-ui/tsconfig.build.json" }
  ]
}
