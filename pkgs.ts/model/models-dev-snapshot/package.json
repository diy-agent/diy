{
    "name": "@diy-agent/models-dev-snapshot",
    "version": "0.1.0",
    "private": true,
    "description": "models.dev 规格快照：data/models.dev.json 由 gen 脚本生成，不进 git；包内快照是目录的离线兜底",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "src/",
        "dist/",
        "data/",
        "scripts/"
    ],
    "scripts": {
        "gen": "tsx scripts/gen.ts",
        "prepare": "tsx scripts/gen.ts",
        "prepack": "MODELS_DEV_STRICT=1 tsx scripts/gen.ts",
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run"
    },
    "dependencies": {},
    "devDependencies": {
        "tsx": "^4.20.6",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
