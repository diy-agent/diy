{
    "name": "@diy-agent/remote",
    "version": "0.1.0",
    "private": true,
    "description": "diy 远程实例：实例身份（永不变的 id + 可改 displayName）/ 四种 endpoint 发现器（local·mdns·tailscale·manual）+ /ping 客户端与服务端",
    "license": "MIT",
    "files": [
        "src/"
    ],
    "type": "module",
    "main": "./lib/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./lib/index.js"
        },
        "./node": {
            "types": "./src/node/index.ts",
            "default": "./lib/node/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json"
    },
    "dependencies": {
        "@diy-agent/time": "*",
        "bonjour-service": "^1.4.4"
    },
    "devDependencies": {
        "oxfmt": "^0.57.0",
        "oxlint": "^1.72.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "oxlint": {
        "rules": {
            "no-unused-vars": "warn",
            "@typescript-eslint/no-unused-vars": [
                "warn",
                {
                    "argsIgnorePattern": "^_"
                }
            ]
        },
        "ignorePatterns": [
            "node_modules/"
        ]
    }
}
