{
  "name": "@diy-agent/bot",
  "version": "0.1.1",
  "private": true,
  "description": "diy 的 bot 实体：身份配置（BotConfig）+ 文件存储（~/.diy/bots/<id>/bot.json）+ 会话归属（session 目录里的 bot.json）",
  "files": [
    "src/"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./persona": {
      "types": "./src/persona.ts",
      "default": "./lib/persona.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@diy-agent/time": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
