{
  "name": "@diy-agent/rpc",
  "version": "0.2.0",
  "description": "diy RPC 协议内核：三层（Envelope 传输抽象 / Raw Client·Server / 声明式 RPC）+ http / ws / electron / CLI 四种传输绑定",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diy-agent/diy.git",
    "directory": "pkgs.ts/diy-rpc"
  },
  "homepage": "https://github.com/diy-agent/diy/tree/main/pkgs.ts/diy-rpc",
  "keywords": [
    "rpc",
    "diy",
    "typescript",
    "streaming",
    "electron"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./http": {
      "types": "./lib/transport/http/index.d.ts",
      "default": "./lib/transport/http/index.js"
    },
    "./ws": {
      "types": "./lib/transport/ws/index.d.ts",
      "default": "./lib/transport/ws/index.js"
    },
    "./electron": {
      "types": "./lib/transport/electron/index.d.ts",
      "default": "./lib/transport/electron/index.js"
    },
    "./cli": {
      "types": "./lib/cli/index.d.ts",
      "default": "./lib/cli/index.js"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "electron": ">=33"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.0"
  },
  "oxlint": {
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    },
    "ignorePatterns": [
      "node_modules/"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
