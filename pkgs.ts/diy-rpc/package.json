{
  "name": "@diy-agent/rpc",
  "version": "0.1.0",
  "description": "diy RPC 协议内核：三层（Envelope 传输抽象 / Raw Client·Server / 声明式 RPC）+ http / ws / electron / CLI 四种传输绑定",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diy-agent/diy.git",
    "directory": "pkgs.ts/diy-rpc"
  },
  "homepage": "https://github.com/diy-agent/diy/tree/main/pkgs.ts/diy-rpc",
  "keywords": ["rpc", "diy", "typescript", "streaming", "electron"],
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/transport/http/index.ts",
    "./ws": "./src/transport/ws/index.ts",
    "./electron": "./src/transport/electron/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "files": ["src/"],
  "dependencies": {
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "electron": ">=33"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "oxfmt": {
    "indent": 2,
    "lineWidth": 100,
    "quotes": "single",
    "ignore": [
      "node_modules/"
    ]
  },
  "oxlint": {
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    },
    "ignorePatterns": [
      "node_modules/"
    ]
  }
}
