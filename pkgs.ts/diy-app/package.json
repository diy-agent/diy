{
  "name": "diy-app",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "diy-app": "bin/diy-app.mjs"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/electron-dev.mts",
    "cli": "tsx src/cli/index.ts",
    "serve": "npm run build:renderer && tsx src/serve/index.ts",
    "serve:build": "npm run build:renderer && vite build --config vite.serve.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:cli": "vite build --config vite.cli.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "start": "npm run build && electron out/main/index.mjs",
    "link": "npm link",
    "clean": "rm -rf out",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:intent": "vitest run tests/cli.intent.test.ts",
    "test:bridge": "npx tsx bin/test-bridge.ts",
    "test:unit": "vitest run --exclude tests/cli.intent.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ tests/",
    "lint:fix": "oxlint --fix src/ tests/",
    "fmt": "oxfmt --check src/ tests/",
    "fmt:fix": "oxfmt --write src/ tests/",
    "check": "npm run typecheck && npm run lint",
    "fix": "npm run fmt:fix && npm run lint:fix",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "icon": "python3 scripts/gen-icon.py"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@base-ui/react": "^1.6.0",
    "@diy/rpc": "^0.1.0",
    "@diy/rpc-transport": "^0.1.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/http-proxy": "^11.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@types/js-yaml": "^4.0.9",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "ws": "^8.21.0",
    "fastify": "^5.9.0",
    "js-yaml": "^5.2.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vitest": "^4.1.9",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "shadcn": "^4.13.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "oxfmt": {
    "indent": 2,
    "lineWidth": 100,
    "quotes": "single",
    "ignore": [
      "out/",
      "node_modules/",
      "dist/"
    ]
  },
  "oxlint": {
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    },
    "ignorePatterns": [
      "out/",
      "node_modules/",
      "dist/"
    ]
  },
  "main": "out/main/index.mjs",
  "description": "diy 管控台 — 任务管理桌面应用",
  "author": "ccc <ccc@users.noreply.github.com>"
}
