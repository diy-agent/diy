{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // 类型检查不 emit：产物落在源码旁会被 bundler/test 的无扩展名解析优先命中（详见根 AGENTS.md）
    "composite": true,
    "noEmit": true,
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src", "tools"],
  "exclude": ["node_modules", "dist", "examples", "test"]
}
