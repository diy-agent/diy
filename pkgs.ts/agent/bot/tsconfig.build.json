{
    // 发布构建：把 src/ 编成 Node 可直接 import 的 ESM + .d.ts（rootDir=src ⇒ lib/ 与 src/ 同构）。
    // 与 tsconfig.json（noEmit 类型检查）并存：check 用那份，构建用这份，别合并。
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
    // tsc -b 需要 composite；增量信息落 node_modules/.cache（不污染包目录、不进 git）
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/tsconfig.build.tsbuildinfo",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node"],
        "rootDir": "src",
        "outDir": "dist",
        "noEmit": false,


        "declaration": true,
        "sourceMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["tests/**/*", "test/**/*", "examples/**/*"]
,
  "references": [
    { "path": "../compaction/tsconfig.build.json" },
    { "path": "../../core/facts/tsconfig.build.json" },
    { "path": "../../core/time/tsconfig.build.json" },
    { "path": "../session/tsconfig.build.json" },
    { "path": "../context/tsconfig.build.json" },
    { "path": "../store-jsonl/tsconfig.build.json" },
    { "path": "../../model/provider/tsconfig.build.json" },
    { "path": "../../model/catalog/tsconfig.build.json" },
    { "path": "../skills/tsconfig.build.json" },
    { "path": "../agents-chain/tsconfig.build.json" },
    { "path": "../../core/kb/tsconfig.build.json" }
  ]
}
