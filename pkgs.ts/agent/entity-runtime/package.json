{
    "name": "@diy-agent/entity-runtime",
    "version": "0.0.1",
    "private": true,
    "description": "实体对话运行时（切片）：Inbox(sqlite) + Agent 事件 + Projection + 消息持久化",
    "type": "module",
    "main": "./src/index.ts",
