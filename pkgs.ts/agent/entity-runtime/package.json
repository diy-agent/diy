        }
    },
    "dependencies": {
        "@ai-sdk/openai-compatible": "^3.0.92",
        "@diy-agent/agents-chain": "*",
        "@diy-agent/context": "*",
        "@diy-agent/kb": "*",
        "@diy-agent/protocol": "*",
        "@diy-agent/skills": "*",
        "@diy-agent/time": "*",
        "ai": "^7.0.173",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "test": "vitest run"
