            "default": "./src/end-reason.ts"
        },
        "./stop-scenarios": {
            "types": "./src/stop-scenarios.ts",
            "default": "./src/stop-scenarios.ts"
        },
        "./room-scenarios": {
            "types": "./src/room-scenarios.ts",
