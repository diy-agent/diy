{
  "name": "@diy-agent/compaction",
  "version": "0.1.0",
  "private": true,
  "description": "压缩决策（纯算不写盘）：保留边界、触发线、保留量、压缩策略与压缩后形态范例",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "@diy-agent/context": "^0.1.0",
    "@diy-agent/time": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
