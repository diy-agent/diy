{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/tsconfig.build.tsbuildinfo",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node"],
        "rootDir": "src",
        "outDir": "lib",
        "noEmit": false,
        "declaration": true,
        "sourceMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["tests/**/*"]
,
  "references": [
    { "path": "../../agent/tools/tsconfig.build.json" }
  ]
}
