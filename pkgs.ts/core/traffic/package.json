{
    "name": "@diy-agent/traffic",
    "version": "0.1.0",
    "private": true,
    "description": "出站流量：内存环形缓冲（FIFO，条数+字节双限）+ 订阅 + 可选落盘",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./src/node/index.ts",
            "default": "./dist/node/index.js"
        }
    },
    "files": [
        "src/"
    ],
    "dependencies": {
        "js-yaml": "^5.5.0"
    },
    "devDependencies": {
        "oxfmt": "^0.57.0",
        "oxlint": "^1.72.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json"
    }
}
