{
  "name": "@diy/context",
  "version": "0.1.0",
  "private": true,
  "description": "上下文树 → 模型 wire 的纯投影：ContextFact/ContextTree 的类型契约、reducer、projection、投递（delivery）与 YAML 信封（envelope）",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "dependencies": {
    "@diy/template": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
