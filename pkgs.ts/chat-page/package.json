{
  "name": "@diy/chat-page",
  "version": "0.1.0",
  "private": true,
  "description": "聊天页面插件：主进程侧用 @diy/session + 假 LlmPort，renderer 侧输入框 + 消息列表",
  "files": [
    "src/"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./main": {
      "types": "./src/main.ts",
      "default": "./lib/main.js"
    },
    "./renderer": {
      "types": "./src/renderer.ts",
      "default": "./lib/renderer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@diy/session": "*",
    "@diy/workbench-ui": "*",
    "@diy/workbench": "*"
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
