{
  "name": "diy-monorepo",
  "private": true,
  "workspaces": [
    "pkgs.ts/*"
  ],
  "scripts": {
    "build": "npm --workspace diy-app run build && npm --workspace diy-app run build:cli",
    "clean": "npm run clean --workspace diy-app",
    "typecheck": "tsc -b tsconfig.all.json --noEmit",
    "lint": "oxlint pkgs.ts/",
    "lint:fix": "oxlint --fix pkgs.ts/",
    "fmt": "oxfmt --check pkgs.ts/",
    "fmt:fix": "oxfmt --write pkgs.ts/",
    "check:browser": "npm --workspace @diy/rpc run check:browser",
    "check": "npm run typecheck && npm run lint && npm run check:browser",
    "test": "npm run test:unit && npm run test:intent",
    "test:unit": "npm --workspace @diy/rpc run test && npm --workspace diy-app run test:unit",
    "test:intent": "npm --workspace diy-app run test:intent",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "solid-markdown": "^2.1.1"
  }
}
