{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@diy-agent/diy-core": ["./packages/diy-core/src/index.ts"],
      "@diy-agent/diy-cli": ["./packages/diy-cli/src/main.ts"],
      "@diy-agent/diy-tui": ["./packages/diy-tui/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/examples"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".diy/ref"
  ]
}
